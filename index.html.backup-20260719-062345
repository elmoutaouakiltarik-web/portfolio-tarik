    .case h4 { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.45rem; letter-spacing: -0.02em; }
    .case p { color: #c8d2ec; font-size: 0.88rem; font-weight: 500; }
    .case .result { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.84rem; font-weight: 700; color: var(--cyan); }

    /* ===== Skills ===== */
    .skills-layout { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 1.2rem; }
    .skill-panel { padding: 1.6rem; }
    .skill-panel h3 { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1.1rem; letter-spacing: -0.02em; }
    .skill-bars { display: grid; gap: 1rem; }
    .skill-bar label { display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: 0.4rem; font-weight: 600; color: #eaf0ff; }
    .skill-bar label span:last-child { font-family: var(--font-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; }
    .bar { height: 6px; border-radius: 99px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .bar > i { display: block; height: 100%; width: 0; border-radius: 99px; background: linear-gradient(90deg, var(--cyan), var(--violet)); transition: width 1.4s var(--ease-out); }
    .skill-cloud { display: flex; flex-wrap: wrap; gap: 0.55rem; align-content: start; padding: 1.6rem; }
    .skill-tag {
