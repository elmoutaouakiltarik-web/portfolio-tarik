    .contact-link .meta strong { font-size: 0.95rem; font-weight: 700; color: var(--text); }
    .contact-aside { display: grid; gap: 0.9rem; align-content: start; }
    .cta-card { padding: 1.4rem; border-radius: 18px; border: 1px solid rgba(255,179,71,0.25); background: rgba(255,179,71,0.06); }
    .cta-card h3 { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.45rem; }
    .cta-card p { color: #c8d2ec; font-size: 0.9rem; margin-bottom: 1rem; font-weight: 500; }
    .avail { display: flex; align-items: center; gap: 0.55rem; font-size: 0.88rem; color: var(--mint); margin-bottom: 1rem; }
    .avail i { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 12px var(--mint); animation: pulse 2s ease infinite; }

    /* ===== Footer ===== */
    footer { padding: 2.5rem 0 3.5rem; border-top: 1px solid var(--line); position: relative; z-index: 3; }
    .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
    .footer-inner p { color: #c8d2ec; font-size: 0.9rem; font-weight: 600; }
    .footer-links { display: flex; gap: 1rem; flex-wrap: wrap; }
    .footer-links a { color: #c8d2ec; font-size: 0.9rem; font-weight: 600; transition: color .2s; }
    .footer-links a:hover { color: var(--cyan); }

    /* ===== Deerflow badge (mandatory) ===== */
    .deerflow-badge {
      position: fixed; right: 14px; bottom: 14px; z-index: 90;
      font-size: 0.68rem; letter-spacing: 0.04em; padding: 0.45rem 0.7rem; border-radius: 999px;
      border: 1px solid var(--line); background: rgba(4,6,13,0.7); backdrop-filter: blur(10px);
      color: #94a3c4; opacity: 0.55; transition: color .25s, border-color .25s, opacity .25s;
    }
    .deerflow-badge:hover { opacity: 1; color: #c8d2ec; border-color: var(--line-2); }

    /* ===== Mobile nav ===== */
    .mobile-nav {
      position: fixed; inset: 0; z-index: 99; background: rgba(3,5,10,0.94);
      backdrop-filter: blur(18px); display: grid; place-items: center;
      opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s;
    }
    .mobile-nav.open { opacity: 1; visibility: visible; }
    .mobile-nav ul { list-style: none; text-align: center; display: grid; gap: 0.4rem; }
    .mobile-nav a { font-family: var(--font-display); font-size: 1.8rem; letter-spacing: -0.03em; padding: 0.5rem 1rem; display: block; color: #c8d2ec; font-weight: 700; transition: color .2s; }
    .mobile-nav a:hover { color: var(--text); }

    /* ===== Responsive ===== */
    @media (max-width: 980px) {
      .hero-grid, .about-grid, .skills-layout, .contact-shell { grid-template-columns: 1fr; }
      .domains-grid { grid-template-columns: 1fr 1fr; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .stat:nth-child(2)::after { display: none; }
      .case-strip { grid-template-columns: 1fr 1fr; }
      .project, .project.wide, .project.tall { grid-column: span 6; min-height: 262px; }
      .float-badge { display: none; }
      .nav-links, .nav-cta { display: none; }
      .burger { display: grid; }
    }
    @media (max-width: 640px) {
      .domains-grid, .case-strip, .stats-row { grid-template-columns: 1fr; }
      .stat:not(:last-child)::after { display: none; }
      .project, .project.wide, .project.tall { grid-column: span 12; }
      .sys-grid { grid-template-columns: 1fr; }
      .hero { padding-top: calc(var(--nav-h) + 1.5rem); }
      section { padding: 4.5rem 0; }
      .manifesto { padding: 3.5rem 0 3rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important; scroll-behavior: auto !important;
      }
      .reveal { opacity: 1; transform: none; }
      .hero h1 .ln > span, .hero-lead, .hero-actions, .hero-meta, .hero-visual { opacity: 1; transform: none; animation: none; }
      .marquee-track { animation: none; }
      body { cursor: auto; }
      .cursor, .cursor-dot, .spotlight { display: none !important; }
      #flow { display: none; }
    }
  </style>
</head>
