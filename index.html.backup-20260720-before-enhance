<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Tarik El Moutaouakil — Industrial AI Architect · CFD-AI · Digital Twin · OT/IT Bridge. Sistemi che sopravvivono in produzione, non in laboratorio. Reggio Emilia, collaborazioni EU." />
  <meta name="author" content="Tarik El Moutaouakil" />
  <meta name="theme-color" content="#04060d" />
  <meta name="color-scheme" content="dark" />
  <meta property="og:title" content="Tarik El Moutaouakil — Industrial AI Architect" />
  <meta property="og:description" content="Digital Twin physics-driven, CFD-AI, automazione OT/IT. Dalla fisica alla produzione." />
  <meta property="og:type" content="website" />
  <title>Tarik El Moutaouakil — Industrial AI · CFD-AI · Digital Twin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      /* The Flow Field — palette */
      --bg: #04060d;
      --bg-2: #070b16;
      --bg-card: rgba(16, 23, 42, 0.92);
      --line: rgba(170, 195, 255, 0.20);
      --line-2: rgba(185, 205, 255, 0.42);
      --text: #f4f7ff;
      --muted: #c8d2ec;
      --faint: #aeb9d6;

      --cyan: #34e7ff;    /* flow */
      --violet: #7c6bff;  /* neural */
      --amber: #ffb347;   /* industry */
      --mint: #5dffb1;    /* live */
      --rose: #ff5d8f;    /* vorticity */

      --radius: 22px;
      --radius-sm: 14px;
      --shadow: 0 30px 80px rgba(0, 0, 0, 0.5);

      --font-display: "Bricolage Grotesque", system-ui, sans-serif;
      --font-body: "Hanken Grotesk", system-ui, sans-serif;
      --font-mono: "IBM Plex Mono", ui-monospace, monospace;

      --nav-h: 74px;
      --max: 1200px;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

      @property --grad { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      font-weight: 500;
      line-height: 1.62;
      overflow-x: hidden;
      cursor: none;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    body.touch-device { cursor: auto; }
    body.touch-device .cursor,
    body.touch-device .cursor-dot,
    body.touch-device .spotlight { display: none !important; }

    ::selection { background: rgba(52, 231, 255, 0.3); color: #fff; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    button { font: inherit; border: 0; background: none; color: inherit; cursor: none; }
    body.touch-device button { cursor: pointer; }

    /* ===== Atmosphere ===== */
    .noise {
      position: fixed; inset: 0; pointer-events: none; z-index: 9990;
      opacity: 0.04; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }
    #flow {
      position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0;
      pointer-events: none; display: block; opacity: 0.85;
    }
    .scrim {
      position: fixed; inset: 0; z-index: 2; pointer-events: none;
      background: linear-gradient(180deg, rgba(4,6,13,0.06) 0%, rgba(4,6,13,0.22) 55%, rgba(4,6,13,0.46) 100%);
    }
    .ambient {
      position: fixed; inset: 0; z-index: 1; pointer-events: none;
      background:
        radial-gradient(900px 520px at 12% -8%, rgba(52, 231, 255, 0.10), transparent 60%),
        radial-gradient(760px 500px at 94% 6%, rgba(124, 107, 255, 0.10), transparent 55%),
        radial-gradient(900px 520px at 50% 108%, rgba(255, 179, 71, 0.05), transparent 55%);
    }
    .spotlight {
      position: fixed; inset: 0; z-index: 1; pointer-events: none;
      background: radial-gradient(380px 380px at var(--sx, 50%) var(--sy, 30%),
        rgba(52, 231, 255, 0.08), transparent 60%);
      transition: background .12s linear;
    }
    /* legibility guard over the now-vivid flow field */
    .hero h1, .hero-lead, .section-kicker, section h2 { text-shadow: 0 2px 40px rgba(2,4,10,0.55); }
    .wrap {
      width: min(var(--max), calc(100% - 2.4rem));
      margin-inline: auto;
      position: relative; z-index: 3;
    }

    /* ===== Custom cursor ===== */
    .cursor, .cursor-dot {
      position: fixed; top: 0; left: 0; border-radius: 50%;
      pointer-events: none; z-index: 10000; transform: translate(-50%, -50%);
      mix-blend-mode: difference;
    }
    .cursor {
      width: 34px; height: 34px;
      border: 1px solid rgba(255,255,255,0.7);
      transition: width .25s var(--ease-out), height .25s var(--ease-out), background .25s, border-color .25s;
    }
    .cursor.is-hover { width: 62px; height: 62px; background: rgba(52,231,255,0.14); border-color: var(--cyan); }
    .cursor-dot { width: 5px; height: 5px; background: #fff; }

    /* ===== Scroll progress (native scroll-driven, progressive) ===== */
    .scroll-prog-track { position: fixed; top: 0; left: 0; height: 3px; width: 100%; z-index: 100; background: linear-gradient(90deg, rgba(52,231,255,0.28), rgba(139,92,246,0.28) 45%, rgba(255,179,71,0.28)); box-shadow: 0 0 8px rgba(52,231,255,0.18); }
    .scroll-prog {
      position: fixed; top: 0; left: 0; height: 3px; width: 100%;
      background: linear-gradient(90deg, var(--cyan), var(--violet) 42%, var(--amber));
      box-shadow: 0 0 10px rgba(52,231,255,0.6), 0 0 22px rgba(139,92,246,0.35);
      transform-origin: 0 50%; transform: scaleX(0); z-index: 101;
    }

    /* ===== Loader ===== */
    .loader {
      position: fixed; inset: 0; z-index: 10001; background: #03050a;
      display: grid; place-items: center;
      transition: opacity .8s var(--ease-out), visibility .8s;
    }
    .loader.done { opacity: 0; visibility: hidden; }
    .loader-inner { text-align: center; width: min(340px, 80vw); }
    .loader-brand {
      font-family: var(--font-display); font-weight: 700; letter-spacing: 0.22em;
      font-size: 0.82rem; color: var(--text); margin-bottom: 1.4rem;
    }
    .loader-bar { height: 2px; background: rgba(255,255,255,0.08); border-radius: 99px; overflow: hidden; }
    .loader-bar > i {
      display: block; height: 100%; width: 0%;
      background: linear-gradient(90deg, var(--cyan), var(--violet), var(--amber));
      animation: load 1.7s var(--ease-out) forwards;
    }
    .loader-pct { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--cyan); }
    @keyframes load { to { width: 100%; } }

    /* ===== Nav ===== */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: var(--nav-h);
      display: flex; align-items: center;
      transition: background .35s, backdrop-filter .35s, border-color .35s;
      border-bottom: 1px solid transparent;
    }
    .nav.scrolled {
      background: rgba(6, 9, 18, 0.9);
      backdrop-filter: blur(20px) saturate(140%);
      border-bottom-color: var(--line-2);
    }
    .nav::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; pointer-events: none;
      background: linear-gradient(90deg, transparent, rgba(52,231,255,0.6), rgba(124,107,255,0.5), transparent);
      opacity: 0; transition: opacity .35s var(--ease-out);
    }
    .nav.scrolled::after { opacity: 1; }
    .nav-inner {
      width: min(var(--max), calc(100% - 2.4rem)); margin-inline: auto;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    .logo { display: flex; align-items: center; gap: 0.7rem; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.02em; }
    .logo-mark {
      width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center;
      background: linear-gradient(135deg, rgba(52,231,255,0.28), rgba(124,107,255,0.2));
      border: 1px solid rgba(52,231,255,0.42);
      font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: #eaf6ff;
      box-shadow: 0 0 24px rgba(52,231,255,0.22), inset 0 1px 0 rgba(255,255,255,0.12);
      transition: box-shadow .3s var(--ease-out), transform .3s var(--ease-out);
    }
    .logo:hover .logo-mark { box-shadow: 0 0 34px rgba(52,231,255,0.42), inset 0 1px 0 rgba(255,255,255,0.18); transform: translateY(-1px); }
    .logo span { font-size: 0.98rem; }
    .logo em { font-style: normal; color: #c8d2ec; font-weight: 600; }
    .nav-links { display: flex; align-items: center; gap: 0.15rem; list-style: none; }
    .nav-links a {
      padding: 0.55rem 0.85rem; font-size: 0.88rem; color: #c8d2ec; font-weight: 600;
      border-radius: 999px; transition: color .25s, background .25s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--text); background: rgba(255,255,255,0.04); }
    .nav-cta {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.68rem 1.1rem; border-radius: 999px;
      background: linear-gradient(135deg, rgba(52,231,255,0.18), rgba(124,107,255,0.16));
      border: 1px solid rgba(52,231,255,0.35); color: var(--text);
      font-size: 0.88rem; font-weight: 600;
      transition: transform .25s var(--ease-out), box-shadow .25s, background .25s;
    }
    .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(52,231,255,0.2); background: linear-gradient(135deg, rgba(52,231,255,0.28), rgba(124,107,255,0.22)); }
    .burger {
      display: none; width: 44px; height: 44px; border-radius: 12px;
      border: 1px solid var(--line); place-items: center; background: rgba(255,255,255,0.03);
    }
    .burger span { display: block; width: 18px; height: 1.5px; background: var(--text); position: relative; }
    .burger span::before, .burger span::after { content: ""; position: absolute; left: 0; width: 18px; height: 1.5px; background: var(--text); transition: transform .25s; }
    .burger span::before { top: -6px; }
    .burger span::after { top: 6px; }

    /* ===== Hero ===== */
    .hero { min-height: 100dvh; padding: calc(var(--nav-h) + 3rem) 0 4rem; display: grid; align-items: center; position: relative; }
    .hero-grid { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 2.5rem; align-items: center; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 0.6rem;
      padding: 0.4rem 0.85rem 0.4rem 0.45rem; border-radius: 999px;
      border: 1px solid var(--line); background: rgba(255,255,255,0.03);
      font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--text);
      letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 1.4rem;
    }
    .eyebrow i {
      width: 8px; height: 8px; border-radius: 50%; background: var(--mint);
      box-shadow: 0 0 12px var(--mint); animation: pulse 2s ease infinite;
    }
    @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } }

    .hero h1 {
      font-family: var(--font-display); font-weight: 800;
      font-size: clamp(2.5rem, 6.4vw, 5.4rem);
      line-height: 0.96; letter-spacing: -0.045em; margin-bottom: 1.3rem;
    }
    .hero h1 .ln { display: block; overflow: hidden; }
    .hero h1 .ln > span {
      display: inline-block; transform: translateY(110%); opacity: 0;
      animation: rise 1s var(--ease-out) forwards;
    }
    .hero h1 .ln:nth-child(1) > span { animation-delay: 0.12s; }
    .hero h1 .ln:nth-child(2) > span { animation-delay: 0.26s; }
    .hero h1 .ln:nth-child(3) > span { animation-delay: 0.4s; }
    @keyframes rise { to { transform: translateY(0); opacity: 1; } }

    .gradient-text {
      background: linear-gradient(120deg, #fff 8%, var(--cyan) 42%, var(--violet) 72%, var(--amber) 100%);
      background-size: 220% auto;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: sheen 9s linear infinite;
    }
    @keyframes sheen { 0% { background-position: 0% center; } 100% { background-position: 220% center; } }

    .hero-lead {
      font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: #d6def3;
      max-width: 38rem; margin-bottom: 2rem; font-weight: 500;
      opacity: 0; animation: fadeUp 1s var(--ease-out) 0.6s forwards;
    }
    .hero-lead strong { color: var(--text); font-weight: 700; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

    .hero-actions {
      display: flex; flex-wrap: wrap; gap: 0.85rem; margin-bottom: 2.4rem;
      opacity: 0; animation: fadeUp 1s var(--ease-out) 0.78s forwards;
    }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
      padding: 0.95rem 1.4rem; border-radius: 999px;
      font-weight: 600; font-size: 0.95rem; min-height: 48px;
      border: 1px solid transparent;
      transition: transform .25s var(--ease-out), box-shadow .25s, background .25s, border-color .25s;
    }
    .btn-primary {
      background: linear-gradient(135deg, #34e7ff, #6d8dff 55%, #7c6bff);
      color: #041018; box-shadow: 0 12px 40px rgba(52,231,255,0.24);
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 18px 50px rgba(52,231,255,0.34); }
    .btn-ghost { border-color: var(--line-2); background: rgba(255,255,255,0.03); color: var(--text); }
    .btn-ghost:hover { transform: translateY(-3px); border-color: rgba(52,231,255,0.4); background: rgba(52,231,255,0.06); }

    .hero-meta {
      display: flex; flex-wrap: wrap; gap: 1.6rem;
      font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; color: #c8d2ec;
      opacity: 0; animation: fadeUp 1s var(--ease-out) 0.95s forwards;
    }
    .hero-meta strong { display: block; color: var(--text); font-size: 0.94rem; font-weight: 700; font-family: var(--font-body); margin-bottom: 0.15rem; }

    /* ===== Hero title frame (glass riquadro) ===== */
    .hero-frame {
      position: relative; margin-bottom: 1.8rem; padding: clamp(1.4rem, 2.4vw, 2.1rem) clamp(1.5rem, 2.8vw, 2.4rem);
      border-radius: 22px; overflow: hidden; contain: layout style paint;
      background: linear-gradient(160deg, rgba(10,16,30,0.74), rgba(8,12,24,0.6));
      border: 1px solid rgba(52,231,255,0.16);
      -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%);
      box-shadow: 0 24px 70px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.06);
      opacity: 0; animation: fadeUp 1s var(--ease-out) 0.15s forwards;
    }
    .hero-frame::after {
      content: ""; position: absolute; inset: 0; border-radius: 22px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(52,231,255,0.6), rgba(124,107,255,0.2) 45%, transparent 78%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
    }
    .hero-frame > * { position: relative; }
    .hero-frame h1 { margin-bottom: 0.4rem; }

    .hero-role {
      display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; min-height: 1.3em;
      font-family: var(--font-mono); font-size: clamp(0.8rem, 1.1vw, 0.92rem); font-weight: 600;
      color: var(--cyan); letter-spacing: 0.05em; text-transform: uppercase;
    }
    .hero-role .role-prompt { color: var(--muted); opacity: 0.72; }
    .hero-role .role-text { color: var(--cyan); }
    .hero-role .role-caret {
      display: inline-block; width: 8px; height: 1.05em; margin-left: 3px; vertical-align: text-bottom;
      background: var(--cyan); box-shadow: 0 0 8px var(--cyan); animation: blink 1s steps(1) infinite;
    }
    .hero-role.done .role-caret { animation: none; opacity: 0.55; }

    .shimmer-line {
      position: absolute; top: 0; left: -35%; width: 38%; height: 100%; pointer-events: none;
      background: linear-gradient(100deg, transparent, rgba(255,255,255,0.11), transparent);
      transform: skewX(-12deg); opacity: 0; animation: shimmerSweep 2.6s var(--ease-out) 0.5s forwards;
    }
    @keyframes shimmerSweep { 0% { left: -35%; opacity: 0; } 18% { opacity: 1; } 100% { left: 120%; opacity: 0; } }

    /* Hero visual */
    .hero-visual { position: relative; opacity: 0; animation: fadeUp 1.1s var(--ease-out) 0.5s forwards; }
    .orbit-card {
      position: relative; border-radius: 26px; padding: 1.4rem;
      background: linear-gradient(160deg, rgba(17,25,43,0.88), rgba(8,12,22,0.82));
      border: 1px solid var(--line-2); box-shadow: var(--shadow); overflow: hidden;
      transform-style: preserve-3d; transition: transform .15s linear;
    }
    .orbit-card::before {
      content: ""; position: absolute; inset: -40% auto auto -20%; width: 70%; height: 70%;
      background: radial-gradient(circle, rgba(52,231,255,0.2), transparent 65%); pointer-events: none;
    }
    .orbit-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.1rem; position: relative; }
    .chip {
      display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.7rem; border-radius: 999px;
      font-size: 0.78rem; font-weight: 600; font-family: var(--font-mono); border: 1px solid var(--line-2);
      background: rgba(255,255,255,0.05); color: var(--text);
    }
    .chip.live { color: var(--mint); border-color: rgba(93,255,177,0.25); background: rgba(93,255,177,0.06); }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 10px var(--mint); }
    .sys-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; margin-bottom: 1rem; position: relative; }
    .sys-tile {
      padding: 0.9rem; border-radius: 14px; background: rgba(20,30,54,0.72);
      border: 1px solid var(--line-2); transition: border-color .25s, transform .25s var(--ease-out), box-shadow .25s; position: relative; overflow: hidden;
    }
    .sys-tile::before { content: ""; position: absolute; top: 0; left: -50%; width: 40%; height: 1px; background: linear-gradient(90deg, transparent, var(--cyan), transparent); animation: tileScan 4s var(--ease-out) infinite; opacity: 0; }
    .sys-tile:nth-child(2)::before { animation-delay: 1s; } .sys-tile:nth-child(3)::before { animation-delay: 2s; } .sys-tile:nth-child(4)::before { animation-delay: 3s; }
    @keyframes tileScan { 0% { left: -50%; opacity: 0; } 30% { opacity: 1; } 60% { opacity: 1; } 100% { left: 110%; opacity: 0; } }
    .sys-tile:hover { border-color: rgba(52,231,255,0.35); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(52,231,255,0.12); }
    .sys-tile .k { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: #c8d2ec; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.3rem; }
    .sys-tile .v { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.03em; }
    .sys-tile .v span { color: var(--cyan); font-size: 0.82rem; font-weight: 600; }
    .terminal {
      border-radius: 14px; background: #060b16; border: 1px solid var(--line-2);
      padding: 0.95rem 1.05rem; font-family: var(--font-mono); font-size: 0.8rem;
      line-height: 1.75; color: #c8d4ec; min-height: 128px; position: relative; font-weight: 500;
    }
    .terminal .prompt { color: var(--cyan); }
    .terminal .ok { color: var(--mint); }
    .terminal .warn { color: var(--amber); }
    .terminal .cmd { color: #dbe7ff; }
    .typed-cursor { display: inline-block; width: 7px; height: 1em; background: var(--cyan); margin-left: 2px; vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .float-badge {
      position: absolute; right: -14px; bottom: 16%; padding: 0.9rem 1.05rem 0.95rem; border-radius: 18px;
      background: linear-gradient(180deg, rgba(14,20,34,0.94), rgba(8,12,22,0.94));
      border: 1px solid rgba(52,231,255,0.32);
      backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
      box-shadow: 0 18px 44px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.07);
      animation: floaty 5s ease-in-out infinite; max-width: 196px;
    }
    .float-badge::after {
      content: ""; position: absolute; left: -8px; bottom: 28px; width: 0; height: 0;
      border-top: 7px solid transparent; border-bottom: 7px solid transparent;
      border-right: 10px solid rgba(12,17,29,0.94);
    }
    .float-badge .fb-pulse { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan); margin-bottom: 0.4rem; font-weight: 700; }
    .float-badge .fb-pulse::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); animation: fb-ring 2s ease-out infinite; }
    .float-badge strong { display: block; font-size: 0.86rem; margin-bottom: 0.2rem; font-weight: 700; }
    .float-badge span { font-size: 0.8rem; font-weight: 600; color: #c8d2ec; line-height: 1.35; }
    .float-chip {
      position: absolute; left: 22px; top: -22px; display: flex; align-items: center; gap: 0.6rem;
      padding: 0.55rem 0.8rem; border-radius: 13px; max-width: 182px;
      background: linear-gradient(180deg, rgba(14,20,34,0.95), rgba(8,12,22,0.95));
      border: 1px solid rgba(255,179,71,0.34);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 14px 34px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.07);
