    }
    .project-visual .pj-photo.pj-fallback { display: none; }
    .project-visual .pj-veil {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background:
        linear-gradient(180deg, rgba(8,12,28,0.42) 0%, rgba(8,12,28,0.16) 42%, var(--bg-card) 100%),
        radial-gradient(130% 95% at 0% 0%, var(--pg, rgba(52,231,255,0.16)), transparent 58%);
      mix-blend-mode: multiply;
    }
    .project-visual svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 1; }
    .project-visual::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 56%; z-index: 2;
      background: linear-gradient(to bottom, transparent, var(--bg-card) 95%);
      pointer-events: none;
    }
    .project-visual::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 3;
      background: linear-gradient(110deg, transparent 36%, rgba(255,255,255,0.1) 50%, transparent 64%);
      transform: translateX(-40%); opacity: 0; transition: opacity .55s var(--ease-out);
      mix-blend-mode: overlay;
    }
    @keyframes pjzoom { from { transform: scale(1.03); } to { transform: scale(1.13) translate(-1.6%, -1.4%); } }
    @media (prefers-reduced-motion: reduce) { .project-visual .pj-photo { animation: none; transform: scale(1.05); } }
    .project:hover .project-visual::before { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .project:hover .project-visual::before { opacity: 0; } }
    .project-top { display: flex; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: 1.1rem; position: relative; }
    .project-id { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--cyan); letter-spacing: 0.08em; }
    .project-status { font-size: 0.74rem; font-weight: 600; padding: 0.32rem 0.65rem; border-radius: 999px; border: 1px solid rgba(93,255,177,0.3); color: var(--mint); background: rgba(93,255,177,0.1); }
    .project h3 { font-family: var(--font-display); font-size: 1.42rem; font-weight: 700; letter-spacing: -0.032em; margin-bottom: 0.55rem; position: relative; }
    .project p { color: #d6def3; font-size: 0.95rem; position: relative; flex: 1; font-weight: 500; line-height: 1.6; }
    .project-metrics { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.2rem; position: relative; }
    .metric { padding: 0.5rem 0.78rem; border-radius: 12px; background: rgba(0,0,0,0.5); border: 1px solid var(--line-2); font-size: 0.85rem; font-weight: 600; color: #eaf0ff; }
    .metric strong { color: var(--cyan); font-weight: 700; }
    .tech-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; position: relative; }
    .tech { font-family: var(--font-mono); font-size: 0.76rem; font-weight: 600; color: #c8d2ec; padding: 0.32rem 0.55rem; border-radius: 8px; border: 1px solid var(--line-2); background: rgba(0,0,0,0.35); }

    /* ===== Case strip ===== */
    .case-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .case {
      position: relative; padding: 1.35rem; border-radius: 18px;
      border: 1px solid rgba(185,205,255,0.38);
      background: linear-gradient(165deg, rgba(20,30,54,0.58), rgba(12,18,34,0.48));
      -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
      box-shadow: 0 8px 28px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.05);
      overflow: hidden;
      transition: transform .3s var(--ease-out), border-color .3s, box-shadow .3s;
    }
    .case::after {
      content: ""; position: absolute; inset: 0; border-radius: 18px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,179,71,0.28), transparent 62%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s var(--ease-out);
    }
    .case::before { content: ""; position: absolute; inset: 0; border-radius: 18px; z-index: 0; pointer-events: none; background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgba(52,231,255,0.12), transparent 62%); opacity: 0; transition: opacity .4s var(--ease-out); }
    .case:hover { transform: translateY(-4px); border-color: rgba(255,179,71,0.4); box-shadow: 0 18px 48px rgba(0,0,0,0.42), 0 0 28px rgba(255,179,71,0.12); }
    .case:hover::before { opacity: 1; }
    .case:hover::after { opacity: 1; }
    .case > * { position: relative; z-index: 1; }
    .case .case-num { display: flex; align-items: center; gap: 0.45rem; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--amber); margin-bottom: 0.7rem; letter-spacing: 0.08em; }
    .case .case-num svg { width: 15px; height: 15px; flex: none; opacity: 0.95; }
    .domain .icon svg, .contact-link .ico svg { stroke-width: 2; }
    .case h4 { font-family: var(--font-display); font-size: 1.08rem; font-weight: 700; margin-bottom: 0.45rem; letter-spacing: -0.02em; }
    .case p { color: #d6def3; font-size: 0.88rem; font-weight: 500; }
    .case .result { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.84rem; font-weight: 700; color: var(--cyan); padding-top: 0.7rem; border-top: 1px solid rgba(52,231,255,0.18); }
    .case-media { position: relative; margin: -1.35rem -1.35rem 1rem; height: 158px; overflow: hidden; background: #0a1124; }
    .case-media img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(1.05) contrast(1.06); transition: transform .55s var(--ease-out); }
    .case:hover .case-media img { transform: scale(1.07); }
    .case-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,9,18,0.1) 0%, rgba(6,9,18,0.28) 50%, rgba(12,18,34,0.82) 100%); pointer-events: none; }
    .case-media .cm-tag { position: absolute; top: 0.7rem; left: 0.75rem; z-index: 2; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; background: rgba(6,9,18,0.55); padding: 0.22rem 0.6rem; border-radius: 999px; border: 1px solid rgba(255,179,71,0.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }

    /* ===== Skills ===== */
    .skills-layout { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 1.2rem; }
    .skill-panel { padding: 1.6rem; }
    .skill-panel h3 { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1.1rem; letter-spacing: -0.02em; }
    .skill-bars { display: grid; gap: 1rem; }
    .skill-bar label { display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: 0.4rem; font-weight: 600; color: #eaf0ff; }
    .skill-bar label span:last-child { font-family: var(--font-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; }
    .bar { height: 6px; border-radius: 99px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .bar > i { display: block; height: 100%; width: 0; border-radius: 99px; background: linear-gradient(90deg, var(--cyan), var(--violet)); transition: width 1.4s var(--ease-out); }
    .skill-cloud { display: flex; flex-wrap: wrap; gap: 0.55rem; align-content: start; padding: 1.6rem; }
    .skill-tag {
      padding: 0.62rem 0.95rem; border-radius: 999px; border: 1px solid var(--line-2);
      background: rgba(0,0,0,0.3); font-size: 0.9rem; font-weight: 600; color: #eaf0ff;
      transition: transform .25s var(--ease-spring), border-color .25s, color .25s, background .25s;
    }
    .skill-tag:hover { transform: translateY(-3px) scale(1.04); border-color: rgba(52,231,255,0.4); color: var(--text); background: rgba(52,231,255,0.08); }
    .skill-tag.hot { border-color: rgba(52,231,255,0.35); color: var(--cyan); background: rgba(52,231,255,0.08); }

    /* ===== Timeline ===== */
    .timeline { position: relative; display: grid; gap: 0; padding-left: 1.4rem; }
    .timeline::before { content: ""; position: absolute; left: 0; top: 0.4rem; bottom: 0.4rem; width: 2px; background: linear-gradient(180deg, var(--cyan), var(--violet), transparent); }
    .tl-item { position: relative; padding: 0 0 1.8rem 1.5rem; }
    .tl-item::before { content: ""; position: absolute; left: -1.48rem; top: 0.45rem; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--cyan); box-shadow: 0 0 0 4px rgba(52,231,255,0.12); }
    .tl-date { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--cyan); margin-bottom: 0.35rem; }
    .tl-item h4 { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
    .tl-item .org { color: var(--amber); font-size: 0.9rem; margin-bottom: 0.4rem; }
    .tl-item p { color: #d6def3; font-size: 0.92rem; max-width: 62ch; font-weight: 500; }

    /* ===== Cert grid (premium trust-seals) ===== */
    .cert-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; }
    .cert {
      position: relative; display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.1rem; border-radius: 14px;
      border: 1px solid rgba(185,205,255,0.36);
      background: linear-gradient(160deg, rgba(20,30,54,0.58), rgba(12,18,34,0.46));
      -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
      box-shadow: 0 8px 24px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.05);
      overflow: hidden; transition: transform .3s var(--ease-out), border-color .3s, box-shadow .3s;
    }
    .cert::after { content: ""; position: absolute; inset: 0; border-radius: 14px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,179,71,0.28), transparent 65%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s var(--ease-out); }
    .cert:hover { transform: translateY(-3px); border-color: rgba(255,179,71,0.42); box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 24px rgba(255,179,71,0.12); }
    .cert:hover::after { opacity: 1; }
    .cert-ico { width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; border-radius: 11px; background: rgba(255,179,71,0.1); border: 1px solid rgba(255,179,71,0.25); color: var(--amber); }
    .cert strong { display: block; font-family: var(--font-display); font-size: 0.92rem; font-weight: 700; color: var(--text); letter-spacing: -0.018em; }
    .cert span { display: block; font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; color: #c8d2ec; margin-top: 2px; }

    /* ===== Contact ===== */
    .contact-shell {
      display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 1.2rem; padding: 2rem;
      border-radius: 28px; border: 1px solid var(--line-2);
      background:
        radial-gradient(620px 320px at 0% 0%, rgba(52,231,255,0.1), transparent 60%),
        radial-gradient(520px 300px at 100% 100%, rgba(124,107,255,0.1), transparent 55%),
        rgba(8,12,22,0.85);
      box-shadow: var(--shadow); overflow: hidden; position: relative;
    }
    .contact-shell h2 { font-family: var(--font-display); font-size: clamp(1.8rem, 3.6vw, 2.6rem); letter-spacing: -0.035em; line-height: 1.05; margin-bottom: 0.9rem; }
    .contact-shell p { color: #c8d2ec; max-width: 42ch; margin-bottom: 1.6rem; font-weight: 500; }
    .contact-links { display: grid; gap: 0.7rem; }
    .contact-link {
      display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.1rem; border-radius: 16px;
      border: 1px solid var(--line); background: rgba(255,255,255,0.03);
      transition: transform .25s var(--ease-out), border-color .25s, background .25s;
    }
    .contact-link:hover { transform: translateX(6px); border-color: rgba(52,231,255,0.35); background: rgba(52,231,255,0.06); }
    .contact-link .ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: rgba(52,231,255,0.1); border: 1px solid rgba(52,231,255,0.2); color: var(--cyan); flex-shrink: 0; }
    .contact-link .meta small { display: block; font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; color: var(--cyan); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.15rem; }
    .contact-link .meta strong { font-size: 0.95rem; font-weight: 700; color: var(--text); }
    .contact-aside { display: grid; gap: 0.9rem; align-content: start; }
    .cta-card { padding: 1.4rem; border-radius: 18px; border: 1px solid rgba(255,179,71,0.25); background: rgba(255,179,71,0.06); }
    .cta-card h3 { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.45rem; }
    .cta-card p { color: #c8d2ec; font-size: 0.9rem; margin-bottom: 1rem; font-weight: 500; }
    .avail { display: flex; align-items: center; gap: 0.55rem; font-size: 0.88rem; color: var(--mint); margin-bottom: 1rem; }
    .avail i { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 12px var(--mint); animation: pulse 2s ease infinite; }

    /* ===== Footer ===== */
    footer { padding: 2.5rem 0 3.5rem; border-top: 1px solid var(--line); position: relative; z-index: 3; }
    .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
    .footer-inner p { color: #c8d2ec; font-size: 0.9rem; font-weight: 600; }
    .footer-links { display: flex; gap: 1rem; flex-wrap: wrap; }
    .footer-links a { color: #c8d2ec; font-size: 0.9rem; font-weight: 600; transition: color .2s; }
    .footer-links a:hover { color: var(--cyan); }

    /* ============================================================
       RE-KING UPGRADE — Process · Lab · Values · Gold accents
       ============================================================ */

    /* Gold signature accent (the king tier) */
    :root { --gold: #ffd479; --gold-2: #e8b34a; }
    .gold-text {
      background: linear-gradient(108deg, #fff 0%, var(--gold) 50%, var(--gold-2) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .gold-underline::after {
      content: ""; position: absolute; left: 0; bottom: 0; height: 2px; width: 100%;
      background: linear-gradient(90deg, var(--gold), var(--gold-2), transparent);
      border-radius: 2px;
    }

    /* ===== Process timeline (horizontal flow) ===== */
    .process-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      position: relative;
    }
    .process-row::before {
      content: ""; position: absolute; left: 6%; right: 6%; top: 32px; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,212,121,0.5), rgba(52,231,255,0.4), rgba(124,107,255,0.4), transparent);
      z-index: 0;
    }
    .process-step {
      position: relative; z-index: 1; padding: 1.3rem; border-radius: 18px;
      background: linear-gradient(165deg, rgba(20,30,54,0.66), rgba(12,18,34,0.48));
      border: 1px solid rgba(170,195,255,0.16);
      -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 10px 32px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.05);
      transition: transform .35s var(--ease-out), border-color .35s, box-shadow .35s;
    }
    .process-step::after {
      content: ""; position: absolute; inset: 0; border-radius: 18px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,212,121,0.3), transparent 60%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s var(--ease-out);
    }
    .process-step:hover { transform: translateY(-6px); border-color: rgba(255,212,121,0.36); box-shadow: 0 22px 56px rgba(0,0,0,0.42), 0 0 28px rgba(255,212,121,0.12); }
    .process-step:hover::after { opacity: 1; }
    .process-num {
      width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
      font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.04em;
      background: linear-gradient(135deg, rgba(255,212,121,0.22), rgba(232,179,74,0.12));
      border: 1px solid rgba(255,212,121,0.4); color: var(--gold);
      box-shadow: 0 0 24px rgba(255,212,121,0.18), inset 0 1px 0 rgba(255,255,255,0.12);
      margin-bottom: 1.1rem;
    }
    .process-step h4 { font-family: var(--font-display); font-size: 1.12rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.4rem; }
    .process-step p { color: #d6def3; font-size: 0.9rem; font-weight: 500; line-height: 1.55; }
    .process-step .ps-tag { display: inline-block; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.5rem; }

    /* ===== Lab grid (scratches / experiments) ===== */
    .lab-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .lab-card {
      position: relative; padding: 1.4rem; border-radius: 18px; min-height: 174px;
      background: linear-gradient(165deg, rgba(14,22,40,0.82), rgba(8,12,24,0.66));
      border: 1px solid rgba(52,231,255,0.18);
      -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 12px 36px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.05);
      overflow: hidden;
      transition: transform .35s var(--ease-out), border-color .35s, box-shadow .35s;
    }
    .lab-card::before {
      content: ""; position: absolute; inset: -50% auto auto -40%; width: 80%; height: 80%;
      background: radial-gradient(circle, rgba(52,231,255,0.16), transparent 62%);
      pointer-events: none; transition: transform .55s var(--ease-out);
    }
    .lab-card:hover { transform: translateY(-5px); border-color: rgba(52,231,255,0.34); box-shadow: 0 22px 56px rgba(0,0,0,0.42), 0 0 28px rgba(52,231,255,0.12); }
    .lab-card:hover::before { transform: scale(1.4); }
    .lab-card .lab-tag {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--cyan); margin-bottom: 0.6rem;
      padding: 0.22rem 0.55rem; border-radius: 999px; border: 1px solid rgba(52,231,255,0.25);
      background: rgba(52,231,255,0.06);
    }
    .lab-card h4 { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem; letter-spacing: -0.02em; position: relative; }
    .lab-card p { color: #d6def3; font-size: 0.88rem; font-weight: 500; line-height: 1.55; position: relative; }
    .lab-card .lab-stack { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.85rem; position: relative; }
    .lab-card .lab-stack span { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; color: #c8d2ec; padding: 0.22rem 0.5rem; border-radius: 7px; border: 1px solid var(--line-2); background: rgba(0,0,0,0.32); }

    /* ===== Values pillars (manifesto esteso) ===== */
    .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .value-card {
      position: relative; padding: 1.6rem 1.4rem; border-radius: 20px;
      background: linear-gradient(165deg, rgba(18,26,48,0.78), rgba(10,15,28,0.62));
      border: 1px solid rgba(170,195,255,0.16);
      -webkit-backdrop-filter: blur(20px) saturate(140%); backdrop-filter: blur(20px) saturate(140%);
      box-shadow: 0 14px 42px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.05);
      overflow: hidden;
      transition: transform .4s var(--ease-out), border-color .4s, box-shadow .4s;
    }
    .value-card::after {
      content: ""; position: absolute; inset: 0; border-radius: 20px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, var(--v-accent, rgba(52,231,255,0.3)), transparent 60%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .4s var(--ease-out);
    }
    .value-card:hover { transform: translateY(-6px); border-color: var(--v-accent, rgba(52,231,255,0.3)); box-shadow: 0 24px 60px rgba(0,0,0,0.42), 0 0 32px rgba(52,231,255,0.1); }
    .value-card:hover::after { opacity: 1; }
    .value-card .vc-num {
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em;
      color: var(--v-accent-solid, var(--cyan)); text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .value-card h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.55rem; position: relative; }
    .value-card p { color: #d6def3; font-size: 0.93rem; font-weight: 500; line-height: 1.58; position: relative; }
    .value-card .vc-ico {
      width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(170,195,255,0.18);
      color: var(--v-accent-solid, var(--cyan)); margin-bottom: 1rem;
    }

    /* ===== Gold accent stat tile (king tier) ===== */
    .stat.gold .num em, .stat.gold .num { background: linear-gradient(108deg, #fff, var(--gold) 60%, var(--gold-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .stat.gold:hover .num { text-shadow: 0 0 28px rgba(255,212,121,0.42); }

    /* ===== Crown accent on logo (subtle king mark) ===== */
    .logo-mark::after {
      content: ""; position: absolute; top: -3px; left: -3px; right: -3px; bottom: -3px;
      border-radius: 13px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,212,121,0.5), transparent 50%, rgba(52,231,255,0.3));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
      padding: 1px; opacity: 0.5; transition: opacity .3s;
    }
    .logo:hover .logo-mark::after { opacity: 1; }
    .logo-mark { position: relative; }

    /* ===== Print CV (a11y / royal escape) ===== */
    @media print {
      .nav, .cursor, .cursor-dot, .spotlight, .noise, #flow, .scrim, .ambient, .scroll-prog-track, .scroll-prog,
      .loader, .mobile-nav, .burger, .deerflow-badge, .float-badge, .float-chip, .marquee { display: none !important; }
      body { cursor: auto !important; background: #fff !important; color: #0a0a0a !important; }
      .prose-frame, .glass, .domain, .case, .bridge-item, .cert, .lab-card, .value-card,
      .process-step, .amb-band, .contact-shell { background: #fff !important; backdrop-filter: none !important; color: #0a0a0a !important; box-shadow: none !important; border: 1px solid #ccc !important; }
      .gradient-text, .gold-text, .h-grad, .stat .num em, .stat.gold .num { color: #0a0a0a !important; -webkit-text-fill-color: #0a0a0a !important; background: none !important; }
      .hero h1 .ln > span, .reveal, [data-split] .word { opacity: 1 !important; transform: none !important; }
      section { padding: 1rem 0 !important; }
      a[href]::after { content: " (" attr(href) ")"; font-size: 0.8em; color: #555; }
      .wrap { width: 100% !important; }
    }

    @media (max-width: 980px) {
      .process-row { grid-template-columns: 1fr 1fr; }
      .process-row::before { display: none; }
      .lab-grid, .values-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .process-row, .lab-grid, .values-grid { grid-template-columns: 1fr; }
    }

    /* ============================================================
       KING v2 — Software House Showroom · Audio Orb · Cinematic polish
       ============================================================ */

    /* ===== Software house hero strip — manifesto + numeri reali ===== */
    .shs-hero {
      position: relative; padding: clamp(2.4rem, 4vw, 3.4rem) clamp(1.6rem, 3vw, 2.6rem);
      border-radius: 28px; overflow: hidden;
      background:
        radial-gradient(520px 280px at 10% 0%, rgba(255,212,121,0.10), transparent 62%),
        radial-gradient(520px 280px at 96% 100%, rgba(52,231,255,0.10), transparent 55%),
        linear-gradient(160deg, rgba(10,16,30,0.86), rgba(8,12,24,0.68));
      border: 1px solid rgba(255,212,121,0.22);
      -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%);
      box-shadow: 0 24px 70px rgba(0,0,0,0.46), inset 0 1px 0 rgba(255,255,255,0.06);
      margin-bottom: 1.6rem;
    }
    .shs-hero::after {
      content: ""; position: absolute; inset: 0; border-radius: 28px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,212,121,0.45), rgba(52,231,255,0.15) 55%, transparent 88%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
    }
    .shs-hero > * { position: relative; }
    .shs-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem;
      padding: 0.32rem 0.82rem; border-radius: 999px;
      border: 1px solid rgba(255,212,121,0.3); background: rgba(255,212,121,0.06);
    }
    .shs-title {
      font-family: var(--font-display); font-weight: 800;
      font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.08; letter-spacing: -0.04em;
      max-width: 28ch; margin-bottom: 1rem; color: #f4f7ff;
    }
    .shs-title em { font-style: normal; }
    .shs-lead { color: #d6def3; font-size: clamp(0.98rem, 1.3vw, 1.08rem); max-width: 58ch; font-weight: 500; line-height: 1.62; }
    .shs-lead strong { color: var(--text); font-weight: 700; }
    .shs-stats {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem;
      margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid rgba(255,212,121,0.22);
    }
    .shs-stats .ss > strong {
      display: block; font-family: var(--font-display); font-weight: 800;
      font-size: clamp(1.3rem, 2.4vw, 1.8rem); letter-spacing: -0.035em; line-height: 1;
      background: linear-gradient(108deg, #fff, var(--gold) 55%, var(--gold-2));
      -webkit-background-clip: text; background-clip: text; color: transparent;
      margin-bottom: 0.3rem;
    }
    .shs-stats .ss span { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; color: #c8d2ec; letter-spacing: 0.04em; }

    /* ===== Product showcase grid (premium golden glass cards) ===== */
    .products-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
    .product-card {
      position: relative; border-radius: 24px; overflow: hidden;
      background: linear-gradient(165deg, rgba(14,22,40,0.92), rgba(8,12,24,0.78));
      border: 1px solid rgba(255,212,121,0.18);
      -webkit-backdrop-filter: blur(20px) saturate(140%); backdrop-filter: blur(20px) saturate(140%);
      box-shadow: 0 18px 54px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);
      transition: transform .45s var(--ease-out), border-color .45s, box-shadow .45s;
      display: flex; flex-direction: column;
    }
    .product-card::after {
      content: ""; position: absolute; inset: 0; border-radius: 24px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,212,121,0.4), transparent 65%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .45s var(--ease-out);
    }
    .product-card:hover { transform: translateY(-8px); border-color: rgba(255,212,121,0.4); box-shadow: 0 32px 80px rgba(0,0,0,0.46), 0 0 36px rgba(255,212,121,0.14); }
    .product-card:hover::after { opacity: 1; }
    .pc-media { position: relative; height: 230px; overflow: hidden; background: #0a1124; }
    .pc-media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.88) contrast(1.06) brightness(0.78); transition: transform .75s var(--ease-out); }
    .product-card:hover .pc-media img { transform: scale(1.08); }
    .pc-media::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(6,9,18,0.18) 0%, rgba(6,9,18,0.44) 55%, rgba(10,16,30,0.94) 100%);
    }
    .pc-media .pc-tag {
      position: absolute; top: 1rem; left: 1rem; z-index: 2;
      display: inline-flex; align-items: center; gap: 0.42rem;
      padding: 0.4rem 0.78rem; border-radius: 999px;
      font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gold); background: rgba(6,9,18,0.62); border: 1px solid rgba(255,212,121,0.4);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    }
    .pc-media .pc-status {
      position: absolute; top: 1rem; right: 1rem; z-index: 2;
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.4rem 0.78rem; border-radius: 999px;
      font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700;
      color: var(--mint); background: rgba(93,255,177,0.08); border: 1px solid rgba(93,255,177,0.3);
    }
    .pc-media .pc-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 8px var(--mint); animation: pulse 2s ease infinite; }
    .pc-media .pc-overlay {
      position: absolute; left: 1.4rem; right: 1.4rem; bottom: 1.1rem; z-index: 2;
      font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.03em; color: #fff;
      text-shadow: 0 2px 18px rgba(0,0,0,0.7), 0 0 30px rgba(2,4,10,0.5);
    }
    .pc-media .pc-overlay span { display: block; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.25rem; }
    .pc-body { padding: 1.4rem 1.5rem 1.6rem; position: relative; flex: 1; display: flex; flex-direction: column; }
    .pc-body h3 { font-family: var(--font-display); font-size: 1.32rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.55rem; }
    .pc-body p { color: #d6def3; font-size: 0.96rem; font-weight: 500; line-height: 1.62; margin-bottom: 1rem; }
    .pc-body p strong { color: var(--text); font-weight: 700; }
    .pc-mkt {
      background: linear-gradient(160deg, rgba(255,212,121,0.08), rgba(52,231,255,0.04));
      border: 1px solid rgba(255,212,121,0.2); border-radius: 14px;
      padding: 0.95rem 1.05rem; margin-bottom: 1.1rem;
    }
    .pc-mkt .pm-k { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.3rem; }
    .pc-mkt p { font-size: 0.88rem; color: #eaf0ff; margin: 0; font-weight: 600; line-height: 1.5; }
    .pc-mkt p em { font-style: normal; color: var(--gold); font-weight: 700; }
    .pc-foot { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: auto; padding-top: 0.9rem; border-top: 1px solid rgba(170,195,255,0.14); }
    .pc-foot .tech { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; color: #c8d2ec; padding: 0.32rem 0.55rem; border-radius: 8px; border: 1px solid var(--line-2); background: rgba(0,0,0,0.35); }
    .pc-rev { display: flex; align-items: center; gap: 0.55rem; font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--cyan); margin-top: 0.6rem; }
    .pc-rev::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }

    /* ===== Capability metric ribbon inside software house ===== */
    .ribbon {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      padding: 1.5rem; border-radius: 22px;
      background: linear-gradient(160deg, rgba(20,30,54,0.72), rgba(12,18,34,0.56));
      border: 1px solid rgba(255,212,121,0.22);
      -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 14px 42px rgba(0,0,0,0.36);
      margin-top: 1.6rem;
    }
    .ribbon .rb { text-align: center; padding: 0.5rem; }
    .ribbon .rb strong {
      display: block; font-family: var(--font-display); font-weight: 800;
      font-size: clamp(1.25rem, 2.2vw, 1.7rem); letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.35rem;
      background: linear-gradient(108deg, #fff, var(--cyan) 50%, var(--violet));
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .ribbon .rb:nth-child(2) strong { background: linear-gradient(108deg, #fff, var(--gold) 50%, var(--gold-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .ribbon .rb span { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; color: #c8d2ec; }
    .ribbon .rb:not(:last-child)::after { content: ""; position: absolute; }

    /* ===== AUDIO ORB — colta aristocratica ambient toggle ===== */
    .audio-orb {
      position: fixed; left: 18px; bottom: 18px; z-index: 95;
      width: 52px; height: 52px; border-radius: 50%;
      background: linear-gradient(160deg, rgba(14,20,34,0.94), rgba(8,12,22,0.94));
      border: 1px solid rgba(255,212,121,0.34);
      -webkit-backdrop-filter: blur(14px) saturate(150%); backdrop-filter: blur(14px) saturate(150%);
      box-shadow: 0 12px 34px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.07);
      display: grid; place-items: center; cursor: none;
      transition: transform .35s var(--ease-out), box-shadow .35s, border-color .35s;
    }
    body.touch-device .audio-orb { cursor: pointer; }
    .audio-orb:hover { transform: scale(1.06); border-color: rgba(255,212,121,0.56); box-shadow: 0 14px 40px rgba(0,0,0,0.5), 0 0 28px rgba(255,212,121,0.22); }
    .audio-orb svg { width: 22px; height: 22px; color: var(--gold); transition: opacity .25s; }
    .audio-orb.playing svg.eq { animation: eqBar 1.1s ease-in-out infinite; }
    .audio-orb .eq-bar { transform-origin: center bottom; }
    @keyframes eqBar { 0%,100% { transform: scaleY(1); } 50% { transform: scaleY(0.45); } }
    .audio-orb .ring {
      position: absolute; inset: -3px; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, transparent 60%, rgba(255,212,121,0.35) 70%, transparent 80%);
      opacity: 0; transition: opacity .5s var(--ease-out);
    }
    .audio-orb.playing .ring { opacity: 1; animation: orbRing 3.4s ease-out infinite; }
    @keyframes orbRing { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.7); opacity: 0; } }
    .audio-orb .ao-label {
      position: absolute; left: 60px; white-space: nowrap;
      font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--gold);
      padding: 0.35rem 0.7rem; border-radius: 999px;
      background: rgba(6,9,18,0.7); border: 1px solid rgba(255,212,121,0.25);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      opacity: 0; transform: translateX(-6px); transition: opacity .3s var(--ease-out), transform .3s var(--ease-out);
      pointer-events: none;
    }
    .audio-orb:hover .ao-label { opacity: 1; transform: translateX(0); }

    /* ===== Cinematic polish ===== */
    /* Section transition dividers (gold → cyan → violet) */
    section[id] { isolation: isolate; }
    .gold-divider {
      position: relative; height: 1px; margin: 0 auto; width: min(var(--max), calc(100% - 2.4rem));
      background: linear-gradient(90deg, transparent 4%, rgba(255,212,121,0.4), rgba(52,231,255,0.3), rgba(124,107,255,0.3), transparent 96%);
      opacity: 0.5;
    }

    /* Reveal gold-shimmer on section-kicker once visible */
    .section-head.in .section-kicker {
      background: linear-gradient(108deg, var(--cyan), var(--gold));
      -webkit-background-clip: text; background-clip: text; color: transparent;
      transition: color .8s var(--ease-out);
    }

    /* Project card gold sweep on hover (added layer) */
    .project::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 4; opacity: 0;
      background: linear-gradient(110deg, transparent 35%, rgba(255,212,121,0.08) 50%, transparent 65%);
      mix-blend-mode: overlay; transition: opacity .45s var(--ease-out);
    }
    .project:hover::before { opacity: 1; }

    /* Marquee gold accent added element */
    .marquee-track span.gold-item { color: var(--gold) !important; }
    .marquee-track span.gold-item::after { color: var(--gold); }

    /* Hero frame gold inner glow on hover */
    .hero-frame { transition: box-shadow .5s var(--ease-out), border-color .5s; }
    .hero-frame:hover { border-color: rgba(255,212,121,0.26); box-shadow: 0 24px 70px rgba(0,0,0,0.42), 0 0 36px rgba(255,212,121,0.1), inset 0 1px 0 rgba(255,255,255,0.06); }

    /* Contact CTA — king tier pulse */
    .cta-card { transition: border-color .4s, box-shadow .4s; }
    .cta-card:hover { border-color: rgba(255,212,121,0.4); box-shadow: 0 20px 54px rgba(0,0,0,0.38), 0 0 28px rgba(255,212,121,0.14); }

    /* Primary button: gold sweep variant */
    .btn-primary::after {
      content: ""; position: absolute; inset: 0; border-radius: 999px; pointer-events: none;
      background: linear-gradient(110deg, transparent 30%, rgba(255,212,121,0.0) 50%, transparent 70%);
      mix-blend-mode: overlay; opacity: 0; transition: opacity .4s;
    }
    .btn-primary:hover::after { opacity: 1; background: linear-gradient(110deg, transparent 30%, rgba(255,212,121,0.2) 50%, transparent 70%); }

    /* Reveal — gold-tinged entrance for cards in software house */
    .shs-gold-reveal { position: relative; }
    .shs-gold-reveal.in .product-card { animation: goldRise .9s var(--ease-out) both; }
    @keyframes goldRise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

    @media (max-width: 980px) {
      .products-grid { grid-template-columns: 1fr; }
      .shs-stats { grid-template-columns: 1fr 1fr; }
      .ribbon { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .shs-stats, .ribbon { grid-template-columns: 1fr 1fr; }
    }

    /* ===== Deerflow badge (mandatory) ===== */
    .deerflow-badge {
      position: fixed; right: 14px; bottom: 14px; z-index: 90;
      font-size: 0.68rem; letter-spacing: 0.04em; padding: 0.45rem 0.7rem; border-radius: 999px;
      border: 1px solid var(--line); background: rgba(4,6,13,0.7); backdrop-filter: blur(10px);
      color: #94a3c4; opacity: 0.55; transition: color .25s, border-color .25s, opacity .25s;
    }
    .deerflow-badge:hover { opacity: 1; color: #c8d2ec; border-color: var(--line-2); }

    /* ===== Mobile nav ===== */
    .mobile-nav {
      position: fixed; inset: 0; z-index: 99; background: rgba(3,5,10,0.94);
      backdrop-filter: blur(18px); display: grid; place-items: center;
      opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s;
    }
    .mobile-nav.open { opacity: 1; visibility: visible; }
    .mobile-nav ul { list-style: none; text-align: center; display: grid; gap: 0.4rem; }
    .mobile-nav a { font-family: var(--font-display); font-size: 1.8rem; letter-spacing: -0.03em; padding: 0.5rem 1rem; display: block; color: #c8d2ec; font-weight: 700; transition: color .2s; }
    .mobile-nav a:hover { color: var(--text); }

    /* ============================================================
       PREMIUM REFINEMENT LAYER — legibility · typography · motion
       ============================================================ */

    /* --- Optical sizing + OpenType features --- */
    html, body { font-optical-sizing: auto; }
    body { font-feature-settings: "kern" 1, "ss01" 1, "cv01" 1; }

    /* --- Balanced wrapping (premium rag control) --- */
    .hero h1, .section-head h2, .contact-shell h2, .manifesto-quote,
    .domain h3, .project h3, .case h4, .bridge-item h4, .tl-item h4 { text-wrap: balance; }
    .section-head p, .hero-lead, .about-copy p, .project p,
    .manifesto-sub, .contact-shell p { text-wrap: pretty; }

    /* --- Anchor offset vs fixed nav --- */
    section[id] { scroll-margin-top: 92px; }

    /* --- Legibility veil — soft blur plate for text on the raw flow field --- */
    .veil {
      position: relative; border-radius: 16px; overflow: hidden;
      background: linear-gradient(160deg, rgba(9,14,28,0.66), rgba(6,9,18,0.44));
      -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
      border: 1px solid rgba(170,195,255,0.12);
      box-shadow: 0 12px 36px rgba(0,0,0,0.30);
    }
    .veil::after {
      content: ""; position: absolute; inset: 0; border-radius: 16px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(52,231,255,0.22), transparent 62%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
    }
    .veil > * { position: relative; }

    /* Section description becomes a glass plate beside the title frame */
    .section-head p {
      padding: 0.95rem 1.15rem; border-radius: 14px;
      background: linear-gradient(160deg, rgba(10,16,30,0.60), rgba(8,12,24,0.40));
      -webkit-backdrop-filter: blur(14px) saturate(135%); backdrop-filter: blur(14px) saturate(135%);
      border: 1px solid rgba(170,195,255,0.10);
      box-shadow: 0 8px 26px rgba(0,0,0,0.26);
      text-shadow: 0 1px 14px rgba(2,4,10,0.45);
    }

    /* Hero meta — subtle blur plate */
    .hero-meta {
      padding: 0.95rem 1.25rem; border-radius: 14px;
      background: linear-gradient(160deg, rgba(10,16,30,0.52), rgba(8,12,24,0.32));
      -webkit-backdrop-filter: blur(13px) saturate(132%); backdrop-filter: blur(13px) saturate(132%);
      border: 1px solid rgba(170,195,255,0.10);
      text-shadow: 0 1px 12px rgba(2,4,10,0.5);
    }

    /* Body copy anti-contrast vs vivid flow field */
    .about-copy p, .project p, .domain p, .case p, .bridge-item p,
    .tl-item p, .skill-bar label, .contact-shell p, .cta-card p,
    .manifesto-sub, .hero-lead { text-shadow: 0 1px 12px rgba(2,4,10,0.45); }

    /* Cards lift off the flow field with crisper backdrop */
    .domain, .glass, .skill-panel, .skill-cloud {
      -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
    }

    /* --- Title gradient accent utility (safe outside data-split) --- */
    .h-grad {
      background: linear-gradient(108deg, #f4f7ff 0%, #34e7ff 52%, #7c6bff 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    /* --- Nav link underline draw --- */
    .nav-links a { position: relative; }
    .nav-links a::after {
      content: ""; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.32rem; height: 1px;
      background: linear-gradient(90deg, var(--cyan), var(--violet));
      transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease-out);
      border-radius: 2px;
    }
    .nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }

    /* --- Focus-visible rings (a11y + premium) --- */
    a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid var(--cyan); outline-offset: 3px; border-radius: 10px;
    }

    /* --- Primary button: living gradient --- */
    .btn-primary { background-size: 200% 100%; animation: btnShift 6s ease infinite; }
    @keyframes btnShift { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

    /* --- Stat ambient glow on the number --- */
    .stat .num { transition: text-shadow .35s, transform .35s var(--ease-out); }
    .stat:hover .num { text-shadow: 0 0 28px rgba(52,231,255,0.45); }

    /* --- Ambient image band (real photography integrated as texture) --- */
    .amb-band {
      position: relative; overflow: hidden; border-radius: var(--radius);
      border: 1px solid var(--line-2); box-shadow: 0 24px 70px rgba(0,0,0,0.45);
      isolation: isolate;
    }
    .amb-band > img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      filter: saturate(0.82) contrast(1.06) brightness(0.58);
      animation: kenburns 24s ease-in-out infinite alternate;
      z-index: 0;
    }
    .amb-band .amb-scrim {
      position: absolute; inset: 0; pointer-events: none; z-index: 1;
      background:
        linear-gradient(180deg, rgba(4,6,13,0.50) 0%, rgba(4,6,13,0.74) 100%),
        radial-gradient(680px 320px at 18% 18%, rgba(52,231,255,0.20), transparent 60%);
    }
    .amb-band .amb-content { position: relative; z-index: 2; }
    @keyframes kenburns { 0% { transform: scale(1.06) translate(0,0); } 100% { transform: scale(1.16) translate(-1.6%, -1.4%); } }
    @media (prefers-reduced-motion: reduce) { .amb-band > img, .btn-primary { animation: none; } }

    /* --- Footer veil + crisp --- */
    footer { -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }

    /* --- Ambient halo behind each section (depth, non-destructive) --- */
    section[id]::before {
      content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: radial-gradient(640px 320px at var(--halo, 82%) 0%, rgba(52,231,255,0.045), transparent 62%);
    }
    section[id] { isolation: isolate; }

    /* --- Ambient band variants (stats / capabilities / energy) --- */
    .stats-band .stats-row { padding: 3.4rem 0; }
    .stats-band .stat .label { color: #e4ebfb; }
    .stats-band .stat:not(:last-child)::after { background: rgba(170,195,255,0.18); }
    .cap-content { display: flex; align-items: center; justify-content: flex-start; min-height: 340px; padding: 4rem 0; }
    .cap-glass { max-width: 46ch; padding: 1.6rem 1.8rem; border-radius: 18px; border: 1px solid rgba(170,195,255,0.16); background: linear-gradient(160deg, rgba(8,12,24,0.80), rgba(5,8,16,0.62)); -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%); box-shadow: 0 20px 58px rgba(0,0,0,0.48), inset 0 1px 0 rgba(255,255,255,0.05); position: relative; }
    .cap-glass .section-kicker { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan); margin-bottom: 0.7rem; }
