    .marquee-track span {
      font-family: var(--font-display); font-weight: 700; font-size: clamp(1.1rem, 2.4vw, 1.7rem);
      letter-spacing: -0.02em; color: #c8d2ec; display: inline-flex; align-items: center; gap: 2.4rem; white-space: nowrap;
    }
    .marquee-track span::after { content: "✦"; color: var(--cyan); font-size: 0.7em; }
    @keyframes scrollX { to { transform: translateX(-50%); } }

    /* ===== Manifesto ===== */
    .manifesto { padding: 5rem 0 4.5rem; position: relative; z-index: 3; }
    .manifesto-quote {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(1.7rem, 4.6vw, 3.3rem); line-height: 1.16; letter-spacing: -0.035em;
      max-width: 30ch;
    }
    .manifesto-quote em { font-style: normal; color: var(--cyan); }
    .manifesto-quote i { font-style: normal; color: var(--violet); }
    .manifesto-sub { margin-top: 1.2rem; color: #c8d2ec; max-width: 46ch; font-size: 1.04rem; font-weight: 600; }

    /* ===== Sections common ===== */
    section { padding: 6.5rem 0; position: relative; z-index: 3; }
    .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 2.6rem; }
    .section-kicker {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; color: var(--cyan);
      letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 0.7rem;
    }
    .section-kicker::before { content: ""; width: 22px; height: 1px; background: var(--cyan); opacity: 0.6; }
    .section-head h2 {
      font-family: var(--font-display); font-size: clamp(1.9rem, 3.9vw, 3.1rem);
      font-weight: 700; letter-spacing: -0.038em; line-height: 1.04; max-width: 18ch;
      color: #f4f7ff;
    }
    .section-head p { max-width: 34ch; color: #d6def3; font-size: 1rem; font-weight: 500; letter-spacing: -0.005em; }

    /* ===== Section title frame (glass riquadro) ===== */
    .section-title-frame {
      --st-accent: rgba(52,231,255,0.16);
      position: relative; padding: 1.1rem 1.5rem 1.2rem; border-radius: 16px;
      background: linear-gradient(160deg, rgba(12,20,38,0.66), rgba(8,12,24,0.5));
      border: 1px solid var(--st-accent);
      -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 14px 44px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.05);
      clip-path: inset(0 0 0 0);
    }
    .section-title-frame .section-kicker { margin-bottom: 0.55rem; position: relative; }
    .section-title-frame .section-kicker::after { content: ""; position: absolute; left: 0; bottom: -4px; width: 0; height: 1px; background: linear-gradient(90deg, var(--cyan), transparent); animation: kickerLine 1.2s var(--ease-out) 0.4s forwards; }
    @keyframes kickerLine { to { width: 100%; } }
    .section-head.in .section-title-frame { animation: frameWipe 0.9s var(--ease-out) 0.05s both; }
    .section-head.in .section-title-frame h2 { animation: titleGlow 1.4s var(--ease-out) 0.35s both; }
    @keyframes titleGlow { 0% { text-shadow: 0 0 0 transparent, 0 2px 40px rgba(2,4,10,0.55); } 45% { text-shadow: 0 0 28px rgba(52,231,255,0.42), 0 2px 40px rgba(2,4,10,0.55); } 100% { text-shadow: 0 2px 40px rgba(2,4,10,0.55); } }
    @keyframes frameWipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    @media (prefers-reduced-motion: reduce) { .section-title-frame { clip-path: inset(0 0 0 0) !important; animation: none !important; } }
    .scramble { display: inline-block; }

    /* ===== Prose frame — glass blur riquadro per leggibilità (anti-contrast vs flow field) ===== */
    .prose-frame {
      position: relative; padding: clamp(1.4rem, 2.6vw, 2.1rem) clamp(1.5rem, 2.8vw, 2.3rem);
      border-radius: 20px; overflow: hidden; contain: layout style paint;
      background: linear-gradient(160deg, rgba(10,16,30,0.62), rgba(8,12,24,0.48));
      border: 1px solid rgba(170,195,255,0.14);
      -webkit-backdrop-filter: blur(20px) saturate(140%); backdrop-filter: blur(20px) saturate(140%);
      box-shadow: 0 18px 54px rgba(0,0,0,0.38), inset 0 1px 0 rgba(255,255,255,0.05);
      transition: border-color .4s var(--ease-out), box-shadow .4s var(--ease-out);
    }
    .prose-frame::after {
      content: ""; position: absolute; inset: 0; border-radius: 20px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(52,231,255,0.32), rgba(124,107,255,0.08) 55%, transparent 82%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
    }
    .prose-frame > * { position: relative; }
    .prose-frame.pf-violet::after { background: linear-gradient(135deg, rgba(124,107,255,0.38), rgba(52,231,255,0.08) 55%, transparent 82%); }
    .prose-frame.pf-amber::after { background: linear-gradient(135deg, rgba(255,179,71,0.34), rgba(255,93,143,0.08) 55%, transparent 82%); }
    .prose-frame.pf-mint::after  { background: linear-gradient(135deg, rgba(93,255,177,0.32), rgba(52,231,255,0.08) 55%, transparent 82%); }
    .manifesto .prose-frame { max-width: none; }
    .manifesto .prose-frame .manifesto-sub { max-width: none; }
    .manifesto-layout { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: clamp(1.6rem, 3vw, 3rem); align-items: center; }
    .manifesto-text { min-width: 0; }
    .manifesto-visual { position: relative; border-radius: 22px; overflow: hidden; border: 1px solid rgba(170,195,255,0.16); box-shadow: 0 24px 70px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06); aspect-ratio: 4 / 3; }
    .manifesto-visual > img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(1.05) contrast(1.06); animation: kenburns 22s ease-in-out infinite alternate; }
    .manifesto-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,9,18,0.12) 0%, rgba(6,9,18,0.5) 70%, rgba(6,9,18,0.82) 100%); pointer-events: none; }
    .manifesto-visual .mv-glass { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; z-index: 2; padding: 0.8rem 1rem; border-radius: 14px; border: 1px solid rgba(170,195,255,0.16); background: linear-gradient(160deg, rgba(8,12,24,0.8), rgba(5,8,16,0.62)); -webkit-backdrop-filter: blur(16px) saturate(150%); backdrop-filter: blur(16px) saturate(150%); box-shadow: 0 12px 36px rgba(0,0,0,0.42); }
    .manifesto-visual .mv-glass .mv-k { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); margin-bottom: 0.25rem; }
    .manifesto-visual .mv-glass .mv-t { font-family: var(--font-display); font-weight: 700; font-size: 0.98rem; color: #f4f7ff; letter-spacing: -0.02em; text-shadow: 0 1px 8px rgba(2,4,10,0.6); }
    @keyframes kenburns { 0% { transform: scale(1) translate(0,0); } 100% { transform: scale(1.08) translate(-1.6%, -1.6%); } }
    @media (max-width: 880px) { .manifesto-layout { grid-template-columns: 1fr; } .manifesto-visual { aspect-ratio: 16 / 9; } }
    @media (prefers-reduced-motion: reduce) { .manifesto-visual > img { animation: none; } }
    /* Legibility guard extension over vivid flow field */
    .prose-frame, .prose-frame * { text-shadow: 0 1px 18px rgba(2,4,10,0.42); }

    /* ===== Word-stagger reveal — signature text motion ===== */
    [data-split] .word {
      display: inline-block; will-change: transform, opacity;
      opacity: 0; transform: translateY(0.45em);
      transition: opacity .7s var(--ease-out), transform .8s var(--ease-out);
      transition-delay: calc(var(--i, 0) * 0.032s);
    }
    [data-split].in .word { opacity: 1; transform: none; }

    .reveal { opacity: 0; transform: translateY(36px); transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out); }
    .reveal.in { opacity: 1; transform: none; }
    .reveal-d1 { transition-delay: 0.08s; } .reveal-d2 { transition-delay: 0.16s; }
    .reveal-d3 { transition-delay: 0.24s; } .reveal-d4 { transition-delay: 0.32s; }

    /* ===== Stats ===== */
    .stats { padding: 0 0 1.5rem; }
    .stats-row {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      padding: 1.4rem; border-radius: 24px; border: 1px solid var(--line-2);
      background: linear-gradient(180deg, rgba(18,26,48,0.92), rgba(10,15,28,0.9));
