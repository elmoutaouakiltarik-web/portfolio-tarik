    }
    .stat { text-align: center; padding: 1rem 0.5rem; position: relative; transition: transform .3s var(--ease-out); }
    .stat:hover { transform: translateY(-3px); }
    .stat:not(:last-child)::after { content: ""; position: absolute; right: 0; top: 20%; bottom: 20%; width: 1px; background: var(--line); }
    .stat .num { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.5rem); letter-spacing: -0.04em; line-height: 1; margin-bottom: 0.45rem; transition: text-shadow .3s; }
    .stat:hover .num { text-shadow: 0 0 24px rgba(52,231,255,0.4); }
    .stat .num em { font-style: normal; color: var(--cyan); }
    .stat .label { font-size: 0.92rem; font-weight: 500; color: #d6def3; letter-spacing: -0.005em; }

    /* ===== About ===== */
    .about-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 1.4rem; }
    .glass { background: var(--bg-card); border: 1px solid var(--line-2); border-radius: var(--radius); backdrop-filter: blur(18px); box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.06); }
    .about-copy { padding: 2rem; -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%); background: linear-gradient(165deg, rgba(16,23,42,0.86), rgba(12,18,34,0.78)); }
    .about-copy h3 { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.03em; margin-bottom: 1rem; font-weight: 700; }
    .about-copy p { color: #d6def3; margin-bottom: 1rem; font-size: 1.02rem; font-weight: 500; }
    .about-copy p strong { color: var(--text); font-weight: 700; }
    .pill-row { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid rgba(170,195,255,0.16); }
    .pill { padding: 0.5rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-2); background: rgba(255,255,255,0.06); font-size: 0.86rem; font-weight: 500; color: var(--text); transition: transform .25s var(--ease-spring), border-color .25s, background .25s, color .25s; }
    .pill:hover { transform: translateY(-2px) scale(1.04); border-color: rgba(52,231,255,0.4); background: rgba(52,231,255,0.08); color: var(--text); }
    .bridge { padding: 1.5rem; display: grid; gap: 0.9rem; }
    .bridge-item {
      position: relative; padding: 1.15rem 1.2rem; border-radius: 16px;
      border: 1px solid rgba(185,205,255,0.38);
      background: linear-gradient(165deg, rgba(20,30,54,0.58), rgba(12,18,34,0.46));
      -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
      box-shadow: 0 10px 32px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.04);
      overflow: hidden;
      transition: transform .3s var(--ease-out), border-color .3s, background .3s, box-shadow .3s;
    }
    .bridge-item::after {
      content: ""; position: absolute; inset: 0; border-radius: 16px; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,179,71,0.28), transparent 60%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s var(--ease-out);
    }
    .bridge-item:hover { transform: translateX(6px); border-color: rgba(52,231,255,0.35); background: linear-gradient(165deg, rgba(52,231,255,0.08), rgba(12,18,34,0.58)); box-shadow: 0 18px 50px rgba(0,0,0,0.42), 0 0 32px rgba(52,231,255,0.14); }
    .bridge-item:hover::after { opacity: 1; }
    .bridge-item .tag { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); margin-bottom: 0.35rem; position: relative; z-index: 1; }
    .bridge-item h4 { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.3rem; position: relative; z-index: 1; }
    .bridge-item p { color: #d6def3; font-size: 0.9rem; font-weight: 500; position: relative; z-index: 1; }

    /* ===== Expertise / Services ===== */
    .domains-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .domain {
      padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--line-2);
      background: linear-gradient(165deg, rgba(20,30,54,0.92), rgba(12,18,34,0.9));
      position: relative; overflow: hidden; min-height: 252px; box-shadow: 0 10px 30px rgba(0,0,0,0.32);
      transition: transform .35s var(--ease-out), border-color .35s, box-shadow .35s;
    }
    .domain::after {
      content: ""; position: absolute; inset: auto -20% -45% auto; width: 170px; height: 170px; border-radius: 50%;
      background: radial-gradient(circle, var(--glow, rgba(52,231,255,0.18)), transparent 70%);
      transition: transform .5s var(--ease-out);
    }
    .domain:hover { transform: translateY(-8px); border-color: rgba(52,231,255,0.28); box-shadow: 0 24px 60px rgba(0,0,0,0.38); }
    .domain:hover::after { transform: scale(1.35); }
    .domain .icon {
      width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center;
      background: rgba(52,231,255,0.1); border: 1px solid var(--line-2); margin-bottom: 1.1rem; color: var(--cyan);
    }
    .domain h3 { font-family: var(--font-display); font-size: 1.22rem; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.55rem; position: relative; padding-bottom: 0.55rem; }
    .domain h3::after { content: ""; position: absolute; left: 0; bottom: 0; width: 32px; height: 2px; border-radius: 99px; background: linear-gradient(90deg, var(--cyan), transparent); }
    .domain p { color: #d6def3; font-size: 0.92rem; font-weight: 500; margin-bottom: 1rem; position: relative; }
    .domain ul { list-style: none; display: grid; gap: 0.35rem; position: relative; z-index: 1; }
    .domain li { font-size: 0.9rem; font-weight: 600; color: #d6def3; padding-left: 0.9rem; position: relative; }
    .domain li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 5px; height: 5px; border-radius: 50%; background: var(--cyan); opacity: 0.7; }

    /* ===== Projects bento ===== */
    .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1rem; }
    .project {
      grid-column: span 4; min-height: 286px; padding: 1.5rem; border-radius: var(--radius);
      border: 1px solid var(--line-2); background: var(--bg-card);
      position: relative; overflow: hidden; display: flex; flex-direction: column;
      box-shadow: 0 10px 30px rgba(0,0,0,0.36);
      transition: transform .4s var(--ease-out), border-color .35s, box-shadow .35s;
    }
    .project.wide { grid-column: span 8; min-height: 320px; }
    .project.tall { grid-column: span 4; min-height: 320px; }
    .project:hover { transform: translateY(-6px) scale(1.008); border-color: rgba(52,231,255,0.32); box-shadow: 0 28px 70px rgba(0,0,0,0.42); }
    .project .bg-glow {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.92;
      background:
        radial-gradient(520px 230px at 0% 0%, var(--pg, rgba(52,231,255,0.12)), transparent 60%),
        linear-gradient(160deg, rgba(255,255,255,0.03), transparent 50%);
    }
    .project-visual {
      position: relative; flex-shrink: 0; z-index: 1;
      margin: -1.5rem -1.5rem 1.15rem; height: 168px; overflow: hidden;
      border-bottom: 1px solid var(--line);
    }
    .project-visual .pj-photo {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
